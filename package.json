{
  "name": "mdb-angular-ui-kit-free",
  "version": "10.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng-packagr -p projects/mdb-angular-ui-kit/ng-package.json -c projects/mdb-angular-ui-kit/tsconfig.lib.prod.json && npm run schematics:build",
    "schematics:build": "tsc -p projects/mdb-angular-ui-kit/tsconfig.schematics.json && npm run schematics:copy-schema && npm run schematics:copy-collection && npm run schematics:copy-package",
    "schematics:copy-schema": "cp projects/mdb-angular-ui-kit/schematics/ng-add/schema.json dist/mdb-angular-ui-kit/schematics/ng-add",
    "schematics:copy-collection": "cp projects/mdb-angular-ui-kit/schematics/collection.json dist/mdb-angular-ui-kit/schematics/",
    "schematics:copy-package": "cp projects/mdb-angular-ui-kit/schematics/package.json dist/mdb-angular-ui-kit/schematics/",
    "test": "ng test",
    "test:lib": "ng test --project mdb-angular-ui-kit",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@fortawesome/fontawesome-free": "^6.0.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular-devkit/build-angular": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^22.2.0",
    "jasmine-core": "~5.2.0",
    "jasmine-spec-reporter": "~7.0.0",
    "jsdom": "^28.1.0",
    "karma-coverage": "~2.2.0",
    "ng-packagr": "^22.1.1",
    "ts-node": "~10.9.2",
    "tslint": "~6.1.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
